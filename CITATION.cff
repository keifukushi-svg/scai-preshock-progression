    given-names: Kei
    affiliation: "Department of Cardiovascular Medicine, Kyorin University Faculty of Medicine"
    orcid: "https://orcid.org/0009-0000-7417-6461"
keywords:
  - cardiogenic shock
  - SCAI shock stage
  - machine learning
  - MIMIC-IV
  - prediction model
